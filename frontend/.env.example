# ChainPlay Environment Configuration Example

# Mode toggle: set to true to force Mock Mode (Bot AI / Cross-Tab BroadcastChannel), false for Live Wagmi On-Chain
NEXT_PUBLIC_USE_MOCK_CHAIN=true

# WalletConnect Cloud Project ID (get one at https://cloud.reown.com / https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d

# RPC URLs (Optional public / Alchemy / Infura fallbacks)
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_HARDHAT_RPC=http://127.0.0.1:8545

# Default Chain ID (11155111 for Sepolia, 421614 for Arbitrum Sepolia, 31337 for Hardhat)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
